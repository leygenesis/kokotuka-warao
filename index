<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Traductor y Diccionario Español - Warao</title>
    <style>
        :root {
            --primary: #2e7d32;
            --primary-light: #e8f5e9;
            --secondary: #1565c0;
            --dark: #212121;
            --light: #f4f6f8;
            --white: #ffffff;
            --border: #e0e0e0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--light);
            color: var(--dark);
            line-height: 1.6;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: var(--white);
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        header {
            background-color: var(--primary);
            color: var(--white);
            padding: 24px;
            text-align: center;
        }

        header h1 {
            font-size: 1.8rem;
            margin-bottom: 6px;
        }

        header p {
            opacity: 0.9;
            font-size: 0.95rem;
        }

        .main-content {
            padding: 24px;
        }

        .search-box {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        input[type="text"] {
            flex: 1;
            padding: 14px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="text"]:focus {
            border-color: var(--primary);
        }

        button {
            background-color: var(--primary);
            color: var(--white);
            border: none;
            padding: 14px 24px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
        }

        button:hover {
            background-color: #1b5e20;
        }

        .presets {
            margin-bottom: 24px;
        }

        .presets h3 {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .preset-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .chip {
            background-color: var(--primary-light);
            color: var(--primary);
            border: 1px solid #c8e6c9;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.88rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .chip:hover {
            background-color: #c8e6c9;
        }

        .result-card {
            background-color: #fafafa;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 24px;
        }

        .result-card h2 {
            font-size: 1rem;
            color: #555;
            margin-bottom: 8px;
        }

        .translation-text {
            font-size: 1.4rem;
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 16px;
        }

        .breakdown {
            margin-top: 16px;
            border-top: 1px dashed var(--border);
            padding-top: 16px;
        }

        .breakdown h4 {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 10px;
        }

        .breakdown-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 8px;
        }

        .word-item {
            background: var(--white);
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid var(--border);
            font-size: 0.88rem;
        }

        .word-item strong {
            color: var(--secondary);
            display: block;
        }

        .dictionary-section h3 {
            font-size: 1.1rem;
            margin-bottom: 12px;
            color: var(--dark);
        }

        .dict-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 10px;
        }

        .dict-item {
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: 6px;
            background-color: var(--white);
        }

        .dict-item span {
            color: #666;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Traductor Español ↔ Warao</h1>
        <p>Asistente interactivo de traducción y diccionario de términos</p>
    </header>

    <div class="main-content">
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="Escribe una palabra o frase en español..." onkeyup="checkEnter(event)">
            <button onclick="translateText()">Traducir</button>
        </div>

        <div class="presets">
            <h3>Frases sugeridas:</h3>
            <div class="preset-tags">
                <span class="chip" onclick="setPreset('No hablamos mal sobre esa persona ni de su decision')">No hablamos mal...</span>
                <span class="chip" onclick="setPreset('A todos nos gusta hablar pero podemos hablar de otros con respeto tambien')">A todos nos gusta hablar...</span>
                <span class="chip" onclick="setPreset('Hola, ¿cómo estás?')">Hola</span>
                <span class="chip" onclick="setPreset('Gracias')">Gracias</span>
            </div>
        </div>

        <div class="result-card" id="resultCard">
            <h2>Traducción en Warao:</h2>
            <div class="translation-text" id="translationOutput">Ingresa un texto o selecciona una frase recomendada.</div>
            
            <div class="breakdown" id="breakdownSection" style="display: none;">
                <h4>Desglose léxico:</h4>
                <div class="breakdown-grid" id="breakdownGrid"></div>
            </div>
        </div>

        <div class="dictionary-section">
            <h3>Vocabulario destacado</h3>
            <div class="dict-list" id="dictList"></div>
        </div>
    </div>
</div>

<script>
    // Base de datos de frases completas
    const phrasesDB = {
        "no hablamos mal sobre esa persona ni de su decision": {
            translation: "Oko tai warao asida dibianaja, a obojona asida dibianaja mita.",
            breakdown: [
                { warao: "Oko", es: "Nosotros" },
                { warao: "Tai warao", es: "Esa persona" },
                { warao: "Asida", es: "Mal / Feo" },
                { warao: "Dibianaja", es: "No hablamos" },
                { warao: "A obojona", es: "Su decisión" },
                { warao: "Mita", es: "Ni / Tampoco" }
            ]
        },
        "a todos nos gusta hablar pero podemos hablar de otros con respeto tambien": {
            translation: "Oko kokotuka dibia obonoa, taikaja oko warao rai yakera dibia ja mita.",
            breakdown: [
                { warao: "Oko kokotuka", es: "Todos nosotros" },
                { warao: "Dibia obonoa", es: "Nos gusta hablar" },
                { warao: "Taikaja", es: "Pero / Sin embargo" },
                { warao: "Warao rai", es: "De los demás" },
                { warao: "Yakera", es: "Con respeto / Bien" },
                { warao: "Dibia ja", es: "Podemos hablar" },
                { warao: "Mita", es: "También" }
            ]
        },
        "hola, ¿cómo estás?": {
            translation: "Yakaraja, ¿katukane ja?",
            breakdown: [
                { warao: "Yakaraja", es: "Hola / Bien" },
                { warao: "Katukane ja", es: "¿Cómo estás?" }
            ]
        },
        "gracias": {
            translation: "Yakera",
            breakdown: [
                { warao: "Yakera", es: "Gracias / Está bien" }
            ]
        }
    };

    // Diccionario de términos sueltos
    const dictionary = [
        { es: "Nosotros", warao: "Oko" },
        { es: "Todos", warao: "Kokotuka" },
        { es: "Hablar", warao: "Dibia" },
        { es: "Querer / Gustar", warao: "Obonoa" },
        { es: "Bien / Respeto", warao: "Yakera" },
        { es: "Persona", warao: "Warao" },
        { es: "Malo / Feo", warao: "Asida" },
        { es: "Decisión / Pensamiento", warao: "Obojona" },
        { es: "Pero", warao: "Taikaja" },
        { es: "También / Tampoco", warao: "Mita" }
    ];

    // Inicializar lista de vocabulario
    function loadDictionary() {
        const dictContainer = document.getElementById('dictList');
        dictContainer.innerHTML = dictionary.map(item => `
            <div class="dict-item">
                <strong>${item.warao}</strong><br>
                <span>${item.es}</span>
            </div>
        `).join('');
    }

    function checkEnter(event) {
        if (event.key === "Enter") {
            translateText();
        }
    }

    function setPreset(text) {
        document.getElementById('searchInput').value = text;
        translateText();
    }

    function translateText() {
        const input = document.getElementById('searchInput').value.trim().toLowerCase();
        const output = document.getElementById('translationOutput');
        const breakdownSection = document.getElementById('breakdownSection');
        const breakdownGrid = document.getElementById('breakdownGrid');

        if (!input) {
            output.innerText = "Por favor ingresa un texto.";
            breakdownSection.style.display = "none";
            return;
        }

        // Buscar frase completa
        if (phrasesDB[input]) {
            const data = phrasesDB[input];
            output.innerText = data.translation;
            
            breakdownGrid.innerHTML = data.breakdown.map(item => `
                <div class="word-item">
                    <strong>${item.warao}</strong>
                    ${item.es}
                </div>
            `).join('');
            
            breakdownSection.style.display = "block";
            return;
        }

        // Buscar término individual en diccionario
        const foundWord = dictionary.find(d => d.es.toLowerCase() === input || d.warao.toLowerCase() === input);
        if (foundWord) {
            output.innerText = `${foundWord.warao} (${foundWord.es})`;
            breakdownSection.style.display = "none";
            return;
        }

        // Si no se encuentra resultado exacto
        output.innerText = "Frase no encontrada en la base de datos de ejemplo.";
        breakdownSection.style.display = "none";
    }

    // Cargar componentes al iniciar
    loadDictionary();
</script>

</body>
</html>
